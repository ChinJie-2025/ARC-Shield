# Copy this file to .env and add your Gemini API key from Google AI Studio.
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash
API_PORT=3002
# Production API setting: allow your frontend's exact origin, e.g.
# APP_ORIGINS=https://arc-shield-1.onrender.com
# Frontend build setting (Render Static Site):
# VITE_API_URL=https://arc-shield-full.onrender.com
